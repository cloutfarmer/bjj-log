# Copy to .env.local and use your own development database (never commit real values).
DATABASE_URL=postgresql://USER:PASSWORD@HOST-pooler/DB?sslmode=verify-full
DATABASE_URL_UNPOOLED=postgresql://USER:PASSWORD@HOST/DB?sslmode=verify-full
NEON_BRANCH=dev
# Choose a strong, unique password (at least 12 characters before public hosting).
BJJ_PASSWORD=

# Independent random secret of at least 32 characters. Keep private.
BJJ_SESSION_SECRET=
